{
  "framework": null,
  "cleanUrls": true,
  "functions": {
    "api/opencode-agent.js": { "maxDuration": 180 }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/docs/clinic-companion"
    },
    {
      "source": "/workbench",
      "destination": "/docs/workbench"
    },
    {
      "source": "/workbench.html",
      "destination": "/docs/workbench.html"
    },
    {
      "source": "/agent",
      "destination": "/docs/agent"
    },
    {
      "source": "/agent.css",
      "destination": "/docs/agent.css"
    },
    {
      "source": "/agent.js",
      "destination": "/docs/agent.js"
    },
    {
      "source": "/clinic-companion",
      "destination": "/docs/clinic-companion"
    },
    {
      "source": "/clinic-companion.css",
      "destination": "/docs/clinic-companion.css"
    },
    {
      "source": "/clinic-companion.js",
      "destination": "/docs/clinic-companion.js"
    },
    {
      "source": "/workbench.css",
      "destination": "/docs/workbench.css"
    },
    {
      "source": "/workbench.js",
      "destination": "/docs/workbench.js"
    },
    {
      "source": "/seca-parser.js",
      "destination": "/docs/seca-parser.js"
    },
    {
      "source": "/clinical-parser.js",
      "destination": "/docs/clinical-parser.js"
    },
    {
      "source": "/example-seca-tableview.csv",
      "destination": "/docs/example-seca-tableview.csv"
    },
    {
      "source": "/example-clinical-inputs.csv",
      "destination": "/docs/example-clinical-inputs.csv"
    },
    {
      "source": "/example-complete-synthetic.json",
      "destination": "/docs/example-complete-synthetic.json"
    },
    {
      "source": "/manual",
      "destination": "/docs/manual"
    },
    {
      "source": "/manual.css",
      "destination": "/docs/manual.css"
    },
    {
      "source": "/manual.js",
      "destination": "/docs/manual.js"
    },
    {
      "source": "/app-design.css",
      "destination": "/docs/app-design.css"
    },
    {
      "source": "/app-nav.js",
      "destination": "/docs/app-nav.js"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/docs/manifest.webmanifest"
    },
    {
      "source": "/service-worker.js",
      "destination": "/docs/service-worker.js"
    },
    {
      "source": "/icons/:path*",
      "destination": "/docs/icons/:path*"
    },
    {
      "source": "/pdf-batches.js",
      "destination": "/docs/pdf-batches.js"
    },
    {
      "source": "/pdf-candidate-review.js",
      "destination": "/docs/pdf-candidate-review.js"
    },
    {
      "source": "/report-pdf.js",
      "destination": "/docs/report-pdf.js"
    },
    {
      "source": "/agent-measurement-state.js",
      "destination": "/docs/agent-measurement-state.js"
    },
    {
      "source": "/pdf-import.mjs",
      "destination": "/docs/pdf-import.mjs"
    },
    {
      "source": "/vendor/:path*",
      "destination": "/docs/vendor/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/docs/assets/:path*"
    },
    {
      "source": "/site.css",
      "destination": "/docs/site.css"
    },
    {
      "source": "/site.js",
      "destination": "/docs/site.js"
    },
    {
      "source": "/intake-form.js",
      "destination": "/docs/intake-form.js"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/icons/:path*",
      "headers": [
        { "key": "Content-Type", "value": "image/png" }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
